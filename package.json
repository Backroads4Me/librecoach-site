		"sharp": "^0.35.3",
		"starlight-plugin-icons": "^1.1.3"
	},
	"devDependencies": {
		"@iconify-json/mdi": "^1.2.3",
		"@types/node": "^26.6.2",
		"@unocss/astro": "^66.6.2",
		"@unocss/preset-icons": "^66.6.0",
		"unocss": "^66.6.2",
		"wrangler": "^4.70.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
